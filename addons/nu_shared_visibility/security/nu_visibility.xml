<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Baseline rights for every NU staff account.

        Odoo ships these groups already; this module only wires them onto the
        standard "Internal User" group so a newly created employee can do their
        job on day one without an administrator ticking boxes per person.

        Rationale for each is in this module's manifest description.
    -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('event.group_event_user')),
            (4, ref('survey.group_survey_user')),
        ]"/>
    </record>

    <!--
        Deliberately NOT granted here: base.group_system ("Role / Administrator"),
        which is what allows creating users and changing configuration. That is
        full administrative control over the database, so it is granted to named
        people (the office director, plus ideally one backup) rather than to
        every employee. See the manifest for how to grant it.
    -->

</odoo>
