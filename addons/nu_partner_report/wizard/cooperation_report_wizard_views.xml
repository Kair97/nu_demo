<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cooperation_report_wizard_form" model="ir.ui.view">
        <field name="name">nu.cooperation.report.wizard.form</field>
        <field name="model">nu.cooperation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cooperation Report">
                <field name="partner_id" invisible="1"/>
                <field name="is_person" invisible="1"/>
                <field name="company_partner_id" invisible="1"/>

                <div class="alert alert-info" role="status">
                    <field name="scope_label" readonly="1" nolabel="1"/>
                </div>

                <group>
                    <field name="email_to" placeholder="type an address to email the report"/>
                    <field name="subject"/>
                </group>
                <field name="body" options="{'style-inline': true}"/>

                <footer>
                    <button name="action_download" type="object" string="Download PDF"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_send_email" type="object" string="Send by Email"
                            class="btn-secondary"/>
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-link"
                            help="Opens as a web page - appears instantly, since it skips PDF rendering."/>
                    <button string="Cancel" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
