<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cooperation_report" model="ir.ui.view">
        <field name="name">res.partner.form.cooperation.report</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_print_cooperation_report"
                            type="object"
                            string="Отчёт о сотрудничестве"
                            class="btn-primary"
                            icon="fa-file-pdf-o"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
